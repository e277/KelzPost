// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String @id @default(cuid())
  username     String @unique
  passwordHash String
}

model Settings {
  id            Int    @id @default(1)
  blogTitle     String @default("The Journal")
  tagline       String @default("Thoughts, stories, and ideas — written to share.")
  logoText      String @default("")
  authorName    String @default("Author")
  authorBio     String @default("")
  authorAvatar  String @default("")
  accentColor   String @default("#C8922A")
  navyColor     String @default("#0A1F44")
  aboutTitle    String @default("About")
  aboutContent  String @default("")
  socialTwitter   String @default("")
  socialInstagram String @default("")
  socialLinkedin  String @default("")
  socialGithub    String @default("")
  navLinks      String @default("[{\"label\":\"Home\",\"href\":\"/\"},{\"label\":\"About\",\"href\":\"/about\"}]")
  heroTag       String @default("Personal Blog")
  heroLayout    String @default("centered")
  footerText    String @default("")
  postsLayout   String @default("grid")
}

model Page {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id    String @id @default(cuid())
  name  String @unique
  order Int    @default(0)
  posts Post[]
}

model Post {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  excerpt     String     @default("")
  content     String     @default("")
  coverImage  String     @default("")
  status      String     @default("draft")
  author      String     @default("")
  category    Category?  @relation(fields: [categoryId], references: [id])
  categoryId  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  publishedAt DateTime?
}
