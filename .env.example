# Copy to .env for local development.

# PostgreSQL. On Vercel, adding a Neon database from the Marketplace sets both automatically.
# DATABASE_URL is the pooled connection (used by the app),
# DATABASE_URL_UNPOOLED is a direct connection (used by drizzle-kit migrations). Locally they can be the same.
DATABASE_URL="postgresql://blog:blog@localhost:5432/blog"
DATABASE_URL_UNPOOLED="postgresql://blog:blog@localhost:5432/blog"

# Signs admin session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Optional: public URL used in RSS, sitemap and link previews.
# On Vercel this defaults to your production domain.
# SITE_URL="https://example.com"

# Optional: Vercel Blob image storage. Connecting a Blob store in Vercel (Storage → Blob)
# sets this. Without it, uploaded images are saved in the database instead.
# BLOB_READ_WRITE_TOKEN=""
